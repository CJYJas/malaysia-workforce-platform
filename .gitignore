# ==============================================================================
# Malaysia Tech Workforce Intelligence Platform - .gitignore
# ==============================================================================

# --- Python Bytecode & Compilation ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Testing, Profiling & Coverage ---
tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/

# --- Environment Variables & Secrets ---
# Never commit credentials or production API keys
.env
.env.local
.env.*.local
.env.production
.env.staging
# Explicitly keep the documented environment template
!.env.example

# --- IDEs, Editors & Operating Systems ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.gemini/

# --- Logs, Dumps & Scratch Files ---
*.log
logs/
*.pid
scratch/
tmp/
temp/

# --- Internal Documentation & Specifications ---
document/

# --- Large Dataset Files (> 100MB blocked by GitHub) ---
# Raw 166MB JobStreet dataset (mount on RunPod Network Volume or download via bootstrap)
data/jobstreet_all_job_dataset.csv
# 160MB processed full CSV export
data/processed/**/*.csv

# --- HuggingFace, Model & Embedding Caches ---
data/cache/
cache/
.cache/
data/models/

# --- Retain Essential Data & Metadata Files ---
!data/skills_taxonomy.json
!data/retrieval_eval_candidates.json
!data/retrieval_evaluation_report.json
!data/processed/**/processing_metadata.json
!data/processed/**/coursera_embeddings_meta.json
