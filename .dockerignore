# Git & version control
.git
.gitignore

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment files and credentials (never leak into Docker images)
