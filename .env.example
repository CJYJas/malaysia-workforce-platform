# ==============================================================================
# Malaysia Tech Workforce Intelligence Platform - Environment Variables
# Copy to .env and populate with your deployment-specific values.
# NEVER commit real API keys, credentials, or production tokens to git.
# ==============================================================================

# --- Networking & Server Configuration ---
PORT=8000
HOST=0.0.0.0
# Allowed CORS origins for frontend access (supports JSON array or comma-separated list)
CORS_ORIGINS=["https://replit.com","http://localhost:3000","http://localhost:5173"]

# --- Account & Learning Persistence ---
# Keep disabled unless the PostgreSQL migrations have been applied and secrets/origins are configured.
AUTH_ENABLED=false
DATABASE_URL=postgresql+psycopg://workforce_user:replace-me@localhost:5432/workforce
AUTH_SIGNING_KEY=replace-with-at-least-32-random-bytes
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=true

# --- Storage & Data Paths ---
# Directory where raw datasets, processed parquets, and embeddings reside.
# On RunPod with Network Volume, set to the mounted volume path (e.g., /workspace/data).
DATA_ROOT=data
# Directory for HuggingFace model cache (keep on Network Volume to prevent re-downloads)
HF_HOME=data/cache/huggingface
# Optional: Hugging Face user access token for high-rate API requests and gated downloads
HF_TOKEN=your_huggingface_token_here

# --- Course Retrieval Engine Configuration ---
# Active retriever algorithm: 'tfidf' (default baseline), 'dense' (sentence-transformers), or 'hybrid' (RRF fusion)
RETRIEVER=tfidf

# --- RunPod Serverless vLLM Endpoint Configuration ---
# Required for live LLM extraction (/profile/parse) and verified narration (explain=llm) on RunPod.
# Obtain your API key from: https://runpod.io/console/serverless/user/settings
RUNPOD_API_KEY=your_runpod_api_key_here

# Your RunPod Serverless Endpoint ID (e.g. abc123xyz or vllm-qwen2-5-7b)
# Official OpenAI-compatible URL format: https://api.runpod.ai/v2/${RUNPOD_ENDPOINT_ID}/openai/v1/chat/completions
RUNPOD_ENDPOINT_ID=your_runpod_serverless_endpoint_id_here

# Optional: Direct override for full chat completions endpoint URL
# RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/your_endpoint_id/openai/v1/chat/completions

# Cold-start timeout limit in seconds for RunPod serverless worker provisioning (default 60.0s)
RUNPOD_TIMEOUT_SECONDS=60.0

# Open-weight instruct model identifier deployed on the vLLM serverless worker
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# --- Generic OpenAI-Compatible vLLM Endpoint (Alternative / Local GPU) ---
# Set to 'true' if running a local or private vLLM instance instead of RunPod Serverless
LLM_ENABLED=false
LLM_ENDPOINT_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
